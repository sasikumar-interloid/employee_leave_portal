<% if notice.present? %>
  <div class="pointer-events-auto w-full overflow-hidden rounded-md border border-green-100 bg-green-50 p-4 text-sm leading-6 shadow-sm"
       role="alert"
       data-controller="auto-dismiss"
       data-auto-dismiss-delay-value="4000">
    <p class="break-words font-medium text-green-900">
      <%= notice %>
    </p>
  </div>
<% end %>

<% if alert.present? %>
  <div class="pointer-events-auto w-full overflow-hidden rounded-md border border-yellow-100 bg-red-50 p-4 text-sm leading-6 shadow-sm"
       role="alert"
       data-controller="auto-dismiss"
       data-auto-dismiss-delay-value="4000">
    <p class="break-words font-medium whitespace-pre-line text-red-700">
      <%= alert %>
    </p>
  </div>
<% end %>
