<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Employee Leave Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= favicon_link_tag "favicon.png" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-800" data-controller="sidebar">
    <%# Navbar %>
    <header class="fixed top-0 left-0 right-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 shadow-sm">
      <%# Left side: hamburger + logo %>
      <div class="flex items-center gap-3">
        <button class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 lg:hidden"
                data-action="click->sidebar#toggle"
          aria-label="Toggle sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <span class="flex items-center gap-2 font-semibold text-primary text-sm sm:text-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Leave Portal
        </span>
      </div>
      <div class="flex items-center gap-2">
        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1 text-sm text-slate-700 transition hover:bg-slate-100">
            <div class="flex size-8 items-center justify-center rounded-full bg-primary text-xs font-semibold text-white">
              <%= current_user.initials %>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-2 w-52 rounded-sm border border-slate-200 bg-white p-2 shadow-lg">
            <div class="border-b border-slate-100 px-3 py-2 text-xs break-words">
              <%= current_user.email %>
            </div>
            <%= link_to "Manage Account",
                dashboard_manage_account_path,
                class: "mt-2 block px-3 py-2 text-sm text-slate-700 transition hover:bg-slate-50 hover:text-slate-900" %>
            <%= button_to "Sign out",
                destroy_user_session_path,
                method: :delete,
                form_class: "mt-1",
                class: "block w-full px-3 py-2 text-left text-sm text-red-700 transition hover:bg-slate-50 hover:text-red-800" %>
          </div>
        </details>
      </div>
    </div>
  </header>
  <%# Mobile overlay %>
  <div class="fixed inset-0 z-20 bg-black/40 lg:hidden hidden"
         data-sidebar-target="overlay"
         data-action="click->sidebar#close"></div>
  <%# Sidebar %>
  <aside class="fixed top-14 left-0 z-20 flex h-[calc(100vh-3.5rem)] w-60 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 lg:translate-x-0"
           data-sidebar-target="panel">
    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
      <%= render "layouts/sidebar_item", icon: "home", label: "Dashboard", path: dashboard_path %>
      <details class="group rounded-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-900">
          <span class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>Leaves</span>
          </span>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-slate-400 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="mt-1 space-y-1 border-l border-slate-200 pl-4 ml-5">
          <%= render "layouts/sidebar_item", icon: "plus-circle", label: "Apply Leave", path: "#" %>
          <%= render "layouts/sidebar_item", icon: "list", label: "Leave Request", path: "#" %>
          <%= render "layouts/sidebar_item", icon: "check-circle", label: "Leave Balances", path: "#" %>
        </div>
      </details>
      <%= render "layouts/sidebar_item", icon: "check-circle", label: "Approvals", path: "#" %>
      <%= render "layouts/sidebar_item", icon: "users", label: "Employees", path: "#" %>
      <%= render "layouts/sidebar_item", icon: "chart-bar", label: "Reports", path: "#" %>
      <div class="pt-4 border-t border-slate-100">
        <div class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">
          Settings
        </div>
        <%= render "layouts/sidebar_item",
            icon: "cog",
            label: "Manage Account",
            path: dashboard_manage_account_path %>
      </div>
    </nav>
  </aside>
  <%# Flash messages %>
  <% if notice.present? || alert.present? %>
    <div class="pointer-events-none fixed inset-x-3 top-16 z-50 flex max-w-sm flex-col gap-3 sm:right-4 sm:left-auto sm:w-full">
      <%= render "shared/flash_simple" %>
    </div>
  <% end %>
  <%# Main content %>
  <main class="pt-14 lg:pl-60">
    <div class="p-6">
      <%= yield %>
    </div>
  </main>
</body>
</html>
