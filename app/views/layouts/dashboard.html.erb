<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Employee Leave Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= favicon_link_tag "favicon.png" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-800" data-controller="sidebar">
    <%# Navbar %>
    <header class="fixed top-0 left-0 right-0 z-30 flex h-14 items-center justify-between border-b border-slate-200 bg-white px-4 shadow-sm">
      <div class="flex items-center gap-3">
        <%# Hamburger (mobile) %>
        <button class="rounded-md p-1.5 text-slate-500 hover:bg-slate-100 lg:hidden"
                data-action="click->sidebar#toggle" aria-label="Toggle sidebar">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <%# Logo %>
        <span class="flex items-center gap-2 font-semibold text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Leave Portal
        </span>
      </div>
      <div class="flex items-center gap-3">
        <%# Notification bell %>
        <button class="relative rounded-md p-1.5 text-slate-500 hover:bg-slate-100" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span class="absolute right-1 top-1 size-2 rounded-full bg-red-500"></span>
        </button>
        <%# Avatar / user menu %>
        <div class="flex items-center gap-2">
          <div class="flex size-8 items-center justify-center rounded-full bg-primary text-xs font-semibold text-white">
            <%= current_user.email[0].upcase %>
          </div>
          <span class="hidden text-sm font-medium sm:block"><%= current_user.email %></span>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
              class: "ml-1 rounded-md px-2 py-1 text-xs text-slate-500 hover:bg-slate-100 hover:text-slate-700" do %>
            Sign out
          <% end %>
        </div>
      </div>
    </header>
    <%# Sidebar overlay (mobile) %>
    <div class="fixed inset-0 z-20 bg-black/40 lg:hidden hidden" data-sidebar-target="overlay" data-action="click->sidebar#close"></div>
    <%# Sidebar %>
    <aside class="fixed top-14 left-0 z-20 flex h-[calc(100vh-3.5rem)] w-60 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 lg:translate-x-0"
           data-sidebar-target="panel">
      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
        <%= render "layouts/sidebar_item", icon: "home", label: "Dashboard", path: dashboard_path %>
        <%= render "layouts/sidebar_item", icon: "plus-circle", label: "Apply Leave", path: "#" %>
        <%= render "layouts/sidebar_item", icon: "list", label: "My Leaves", path: "#" %>
        <%= render "layouts/sidebar_item", icon: "check-circle", label: "Approvals", path: "#" %>
        <%= render "layouts/sidebar_item", icon: "users", label: "Employees", path: "#" %>
        <%= render "layouts/sidebar_item", icon: "chart-bar", label: "Reports", path: "#" %>
        <div class="pt-4 border-t border-slate-100">
          <%= render "layouts/sidebar_item", icon: "cog", label: "Settings", path: "#" %>
        </div>
      </nav>
    </aside>
    <%# Flash messages %>
    <% if notice.present? || alert.present? %>
      <div class="pointer-events-none fixed right-4 top-16 z-50 flex w-full max-w-sm flex-col gap-3">
        <% if notice.present? %>
          <div class="pointer-events-auto rounded-md border border-green-100 bg-green-50 p-4 text-sm shadow-sm"
               role="alert" data-controller="auto-dismiss" data-auto-dismiss-delay-value="4000">
            <p class="font-medium text-green-900"><%= notice %></p>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="pointer-events-auto rounded-md border border-red-100 bg-red-50 p-4 text-sm shadow-sm"
               role="alert" data-controller="auto-dismiss" data-auto-dismiss-delay-value="4000">
            <p class="font-medium text-red-700"><%= alert %></p>
          </div>
        <% end %>
      </div>
    <% end %>
    <%# Main content %>
    <main class="min-h-screen pt-14 lg:pl-60">
      <div class="p-6">
        <%= yield %>
      </div>
    </main>
  </body>
</html>
