<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Employee Leave Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= favicon_link_tag "favicon.png" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="bg-slate-50" data-controller="sidebar">
      <%= render "layouts/navbar" %>
      <%# Mobile overlay %>
      <div class="fixed inset-0 z-20 bg-black/40 lg:hidden hidden"
         data-sidebar-target="overlay"
         data-action="click->sidebar#close"></div>
      <%# Sidebar %>
      <aside class="fixed top-14 left-0 z-20 flex h-[calc(100vh-3.5rem)] w-60 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 lg:translate-x-0"
           data-sidebar-target="panel">
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          <%= render "layouts/sidebar_item", icon: "home", label: "Dashboard", path: dashboard_path %>
          <details class="group rounded-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2.5 text-sm font-medium transition hover:bg-slate-50 hover:text-slate-900">
              <span class="flex items-center gap-3">
                <%= app_icon("calendar", css_class: "size-5") %>
                <span>Leaves</span>
              </span>
              <%= app_icon("chevron-down", css_class: "size-4 transition group-open:rotate-180") %>
            </summary>
            <div class="mt-1 space-y-1 border-l border-slate-200 pl-4 ml-5">
              <%= render "layouts/sidebar_item", icon: "plus-circle", label: "Apply Leave", path: "#" %>
              <%= render "layouts/sidebar_item", icon: "list", label: "Leave Request", path: "#" %>
              <%= render "layouts/sidebar_item", icon: "check-circle", label: "Leave Balances", path: "#" %>
            </div>
          </details>
          <%= render "layouts/sidebar_item", icon: "check-circle", label: "Approvals", path: "#" %>
          <%= render "layouts/sidebar_item", icon: "users", label: "Employees", path: "#" %>
          <%= render "layouts/sidebar_item", icon: "chart-bar", label: "Reports", path: "#" %>
          <div class="pt-4 border-t border-slate-100">
            <div class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.2em] text-black">
              Settings
            </div>
            <%= render "layouts/sidebar_item",
            icon: "cog",
            label: "Manage Account",
            path: dashboard_manage_account_path %>
          </div>
        </nav>
      </aside>
      <%# Flash messages %>
      <% if notice.present? || alert.present? %>
        <div class="pointer-events-none fixed inset-x-3 top-16 z-50 flex max-w-sm flex-col gap-3 sm:right-4 sm:left-auto sm:w-full">
          <%= render "shared/flash_simple" %>
        </div>
      <% end %>
      <%# Main content %>
      <main class="pt-14 lg:pl-60">
        <div class="p-6">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
