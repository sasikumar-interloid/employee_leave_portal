<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Employee Leave Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#f5f5f3] text-slate-900">

   
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 py-6">

      <% if notice.present? || alert.present? %>
        <div class="mx-auto w-full max-w-xl space-y-3 mb-4">

          <% if notice.present? %>
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 shadow-sm">
              <%= notice %>
            </div>
          <% end %>

          <% if alert.present? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800 shadow-sm">
              <%= alert %>
            </div>
          <% end %>

        </div>
      <% end %>

      <main class="flex flex-1 items-center justify-center">
        <% if content_for?(:full_width_auth) %>
          <div class="w-full max-w-7xl">
            <%= yield %>
          </div>
        <% else %>
          <div class="w-full max-w-md rounded-2xl p-6 sm:p-8">
            <%= yield %>
          </div>
        <% end %>
      </main>

      <% unless content_for?(:hide_footer) %>
        <footer class="mt-6 text-center text-xs text-slate-500">
          © <%= Time.current.year %> Employee Leave Portal
        </footer>
      <% end %>

    </div>

  </body>
</html>
