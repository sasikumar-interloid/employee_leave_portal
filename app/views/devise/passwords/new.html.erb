<% content_for :title, "Forgot Password" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>

<section class="mx-auto w-full max-w-3xl overflow-hidden rounded-[2rem] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)] lg:grid lg:min-h-[560px]">
  <div class="flex items-center px-3 py-4 sm:px-4 lg:px-6 lg:py-6">
    <div class="mx-auto w-full max-w-md">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Reset your password</h1>
      <p class="mt-4 text-base leading-7 text-slate-500">
        Enter your email address and we will send you instructions to reset your password.
      </p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { class: "mt-10 space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium text-slate-900" %>
          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            placeholder: "Enter your email",
                            class: "mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <%= f.submit "Send reset instructions", class: "mt-2 inline-flex w-full items-center justify-center rounded-2xl bg-[#44652d] px-4 py-3.5 text-sm font-semibold text-white transition hover:bg-[#365123] focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>

      <div class="mt-8 text-center text-sm text-slate-600">
        Remembered your password?
        <%= link_to "Login", new_session_path(resource_name), class: "font-semibold text-[#44652d] hover:text-[#31481f]" %>
      </div>
    </div>
  </div>
</section>
