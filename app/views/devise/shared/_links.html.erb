<div class="mt-6 flex flex-col gap-3 border-t border-slate-200 pt-6">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Log in", new_session_path(resource_name), class: "text-sm font-medium text-teal-700 transition hover:text-teal-900" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Create an account", new_registration_path(resource_name), class: "text-sm font-medium text-teal-700 transition hover:text-teal-900" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-sm font-medium text-teal-700 transition hover:text-teal-900" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Resend confirmation instructions", new_confirmation_path(resource_name), class: "text-sm font-medium text-teal-700 transition hover:text-teal-900" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Resend unlock instructions", new_unlock_path(resource_name), class: "text-sm font-medium text-teal-700 transition hover:text-teal-900" %>
  <% end %>

</div>
