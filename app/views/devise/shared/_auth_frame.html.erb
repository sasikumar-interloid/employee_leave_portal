<section class="grid w-full max-w-5xl gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
  <div class="relative overflow-hidden rounded-[2rem] bg-slate-900 px-6 py-8 text-slate-50 shadow-[0_30px_80px_rgba(15,23,42,0.18)] sm:px-8 sm:py-10 lg:px-10 lg:py-12">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(45,212,191,0.22),_transparent_26%),radial-gradient(circle_at_bottom_left,_rgba(251,191,36,0.14),_transparent_28%)]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/60 to-transparent"></div>

    <div class="relative">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-teal-200">Employee Leave Portal</p>
      <h1 class="mt-4 text-4xl leading-tight font-['Iowan_Old_Style','Palatino_Linotype','Book_Antiqua',Georgia,serif] sm:text-5xl"><%= aside_title %></h1>
      <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300 sm:text-base"><%= aside_body %></p>

      <div class="mt-8 flex flex-wrap gap-3">
        <span class="rounded-full border border-white/10 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-100 backdrop-blur">Leave balances</span>
        <span class="rounded-full border border-white/10 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-100 backdrop-blur">Approval flow</span>
        <span class="rounded-full border border-white/10 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-100 backdrop-blur">Status tracking</span>
      </div>

      <div class="mt-10 grid gap-3 text-sm text-slate-200 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 backdrop-blur">
          <p class="text-xs uppercase tracking-[0.18em] text-teal-200">Balances</p>
          <p class="mt-2 leading-6 text-slate-300">Keep leave totals visible before requests are submitted.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 backdrop-blur">
          <p class="text-xs uppercase tracking-[0.18em] text-teal-200">Approvals</p>
          <p class="mt-2 leading-6 text-slate-300">Move requests through managers without email handoffs.</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 backdrop-blur">
          <p class="text-xs uppercase tracking-[0.18em] text-teal-200">History</p>
          <p class="mt-2 leading-6 text-slate-300">Track status and decisions from one place.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-[2rem] border border-white/70 bg-white/90 p-6 shadow-[0_24px_70px_rgba(15,23,42,0.08)] backdrop-blur sm:p-8">
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-teal-700"><%= eyebrow %></p>
      <div class="space-y-2">
        <h1 class="text-3xl leading-tight text-slate-950 font-['Iowan_Old_Style','Palatino_Linotype','Book_Antiqua',Georgia,serif] sm:text-[2.2rem]"><%= title %></h1>
        <p class="text-sm leading-7 text-slate-600"><%= description %></p>
      </div>
    </div>

    <%= card_content %>
  </div>
</section>
