<% if resource.errors.any? %>
  <div id="error_explanation" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-900" data-controller="auto-dismiss" data-auto-dismiss-delay-value="4000" data-turbo-temporary>
    <h2 class="font-semibold">Please fix the following:</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
