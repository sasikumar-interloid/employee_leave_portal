<% content_for :title, "Resend Confirmation" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>
<%
  token_error = resource.errors.of_kind?(:confirmation_token, :blank) ||
    resource.errors.of_kind?(:confirmation_token, :invalid)
  other_errors_present = resource.errors.attribute_names.any? do |attribute|
    attribute.to_sym != :confirmation_token
  end
%>

<section class="mx-auto sm:w-[60%] md:w-[50%] lg:w-[50%] xl:w-[40%] 2xl:w-[40%] overflow-hidden rounded-[8px] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)] lg:grid">
  <div class="flex items-center px-4 py-4 sm:px-10 lg:px-8 lg:py-8">
    <div class="mx-auto w-full">
      <h1 class="text-center text-lg font-semibold tracking-tight text-slate-950">Confirm your address</h1>
      <p class="mt-4 text-sm leading-7">
        Request a fresh confirmation email if your original link expired or never arrived.
      </p>

      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "mt-10 space-y-6" }) do |f| %>
        <% if token_error %>
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900" data-controller="auto-dismiss" data-auto-dismiss-delay-value="4000" data-turbo-temporary>
            This confirmation link is missing, expired, or invalid. Enter your email below and we will send you a new confirmation email.
          </div>
        <% end %>

        <%= render "devise/shared/error_messages", resource: resource if other_errors_present %>

        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium text-slate-900" %>
          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            value: (resource.try(:pending_reconfirmation?) ? resource.unconfirmed_email : resource.email),
                            placeholder: "Enter your email",
                            class: "mt-2 w-full rounded-md border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <%= f.submit "Resend confirmation instructions", class: "mt-2 inline-flex w-full items-center justify-center rounded-md bg-[#44652d] px-4 py-3.5 text-sm font-semibold text-white transition hover:bg-[#365123] focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>

      <div class="mt-8 text-center text-sm text-slate-600">
        Remembered your password?
        <%= link_to "Login", new_session_path(resource_name), class: "font-semibold text-[#44652d] hover:text-[#31481f]" %>
      </div>
    </div>
  </div>
</section>
