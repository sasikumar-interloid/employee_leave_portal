
<% content_for :title, "Log In" %>

<% card_content = capture do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: "text-sm font-semibold text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/15", placeholder: "you@company.com" %>
    </div>

    <div>
      <%= f.label :password, class: "text-sm font-semibold text-slate-700" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-2 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/15", placeholder: "Enter your password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-3 text-sm font-medium text-slate-600">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-teal-600/30" %>
        <span>Remember me on this device</span>
      </label>
    <% end %>

    <div>
      <%= f.submit "Log in", class: "inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-900/15" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>

<%= render "devise/shared/auth_frame",
           eyebrow: "Secure access",
           title: "Log in",
           description: "Use your account to review leave balances, submit requests, and track approvals in one place.",
           aside_title: "Keep every leave request moving.",
           aside_body: "A single portal for employees and managers keeps balances accurate, handoffs visible, and approvals out of the inbox.",
           card_content: card_content %>
