<% content_for :title, "Login" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>

<section class="mx-auto sm:w-[40%] md:w-[40%] lg:2xl:w-[45%]   p-6 md:p-8 rounded-[8px] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)]">
  <div class="flex items-center px-3 py-4 sm:px-4 lg:px-6 lg:py-6">
    <div class="mx-auto">
      <h1 class="font-semibold text-2xl text-center">Welcome back</h1>
      <p class="mt-4 text-sm leading-7 lx:leading-2">
        Sign in to continue managing leave requests, balances, and approvals.
      </p>  

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-10 space-y-6", data: { controller: "password-visibility" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email,
                            autofocus: true,
                            placeholder: "Enter your email",
                            class: "mt-2 w-full rounded-[8px] border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <div>
          <div class="flex items-center justify-between gap-4">
            <%= f.label :password, class: "text-sm font-medium text-slate-900" %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm font-medium text-[#44652d]" %>
          </div>
          <%= f.password_field :password,
                               placeholder: "Enter your password",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full rounded-[8px] border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <div class="flex">
            <label class="flex items-center gap-3 text-sm">
            <input type="checkbox"
                  class="h-4 w-4 rounded"
                  data-action="password-visibility#toggle">
            <span data-password-visibility-target="toggleLabel">Show password</span>
          </label>

          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-3 text-sm ml-auto">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded " %>
              <span>Remember me</span>
            </label>
          <% end %>
        </div>
        

        <%= f.submit "Login", class: "mt-2 inline-flex w-full items-center justify-center rounded-[8px] bg-[#44652d] px-4 py-3.5 text-sm font-semibold text-white transition hover:bg-[#365123] focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>

      <div class="mt-8 text-center text-sm text-slate-600">
        <% if devise_mapping.registerable? %>
          Don't have an account?
          <%= link_to "Sign up", new_registration_path(resource_name), class: "font-semibold text-[#44652d] hover:text-[#31481f]" %>
        <% end %>
      </div>
    </div>
  </div>

</section>
