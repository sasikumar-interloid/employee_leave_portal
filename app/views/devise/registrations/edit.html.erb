<% content_for :title, "Edit Account" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>

<section class="mx-auto w-full max-w-3xl overflow-hidden rounded-[2rem] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)] lg:min-h-[560px]">
  <div class="flex items-center px-3 py-4 sm:px-4 lg:px-6 lg:py-6">
    <div class="mx-auto w-full max-w-md">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Manage your account</h1>
      <p class="mt-4 text-base leading-7 text-slate-500">
        Update your email or password and keep your access details current.
      </p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-10 space-y-6", data: { controller: "password-visibility" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium text-slate-900" %>
          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            placeholder: "Enter your email",
                            class: "mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Confirmation pending for <span class="font-semibold"><%= resource.unconfirmed_email %></span>.
          </div>
        <% end %>

        <div>
          <%= f.label :current_password, "Current password", class: "text-sm font-medium text-slate-900" %>
          <%= f.password_field :current_password,
                               autocomplete: "current-password",
                               placeholder: "Enter your current password to save changes",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
          <p class="mt-2 text-xs leading-6 text-slate-500">Your current password is required to confirm profile updates.</p>
        </div>

        <div>
          <%= f.label :password, "New password", class: "text-sm font-medium text-slate-900" %>
          <%= f.password_field :password,
                               autocomplete: "new-password",
                               placeholder: "Leave blank to keep your current password",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
          <p class="mt-2 text-xs leading-6 text-slate-500">Leave this empty if you do not want to change it.</p>
          <% if @minimum_password_length %>
            <p class="mt-2 text-xs leading-6 text-slate-500"><%= @minimum_password_length %> characters minimum.</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "text-sm font-medium text-slate-900" %>
          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               placeholder: "Repeat the new password",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#44652d] focus:ring-4 focus:ring-[#44652d]/10" %>
        </div>

        <label class="flex items-center gap-3 text-sm text-slate-600">
          <input type="checkbox"
                 class="h-4 w-4 rounded border-slate-300 text-[#44652d] focus:ring-[#44652d]/20"
                 data-action="password-visibility#toggle">
          <span data-password-visibility-target="toggleLabel">Show password</span>
        </label>

        <%= f.submit "Save changes", class: "mt-2 inline-flex w-full items-center justify-center rounded-2xl bg-[#44652d] px-4 py-3.5 text-sm font-semibold text-white transition hover:bg-[#365123] focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>

      <div class="my-8 border-t border-slate-200"></div>

      <div class="space-y-4">
        <div class="space-y-1">
          <h3 class="text-lg font-semibold text-slate-900">Session</h3>
          <p class="text-sm leading-6 text-slate-600">Sign out of the current session when you are done using the portal.</p>
        </div>

        <%= button_to "Logout",
                      destroy_user_session_path,
                      method: :delete,
                      class: "inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-900/10" %>

        <div class="space-y-1">
          <h3 class="text-lg font-semibold text-slate-900">Close account</h3>
          <p class="text-sm leading-6 text-slate-600">If you no longer need access, you can permanently remove your account.</p>
        </div>

        <%= button_to "Cancel my account",
                      registration_path(resource_name),
                      method: :delete,
                      class: "inline-flex items-center justify-center rounded-2xl bg-rose-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-600/20",
                      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" } %>

        <%= link_to "Back", (request.referer.presence || new_session_path(resource_name)), class: "text-sm font-medium text-slate-600 transition hover:text-slate-900" %>
      </div>
    </div>
  </div>
</section>
