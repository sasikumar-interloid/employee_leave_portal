<% content_for :title, "Edit Account" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>
<section class="mx-auto w-full 2xl:w-[50%] xl:w-[50%] lg:w-[50%] md:w-[50%] sm:w-[70%] overflow-hidden rounded-md bg-white shadow-xl">
  <div class="flex items-center px-3 py-4 sm:px-4 lg:px-6 lg:py-6">
    <div class="mx-auto w-full">
      <h1 class="text-lg font-semibold tracking-tight sm:text-lg text-center">Manage your account</h1>
      <p class="mt-4 text-sm leading-7 text-center">Update your email or password and keep your access details current.</p>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-10 space-y-6", 
          data: { controller: "password-visibility form-validation", action: "submit->form-validation#validateForm focusout->form-validation#validateField input->form-validation#validateField" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email,autofocus: true,autocomplete: "email",placeholder: "Enter your email",
          required: true,data: { form_validation_target: "field", form_validation_required_message: "Email address is required." },
          class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition focus:border-primary" %>
        </div>
        <div>
          <%= f.label :current_password, "Current password", class: "text-sm font-medium " %>
          <%= f.password_field :current_password,autocomplete: "current-password",placeholder: "Enter your current password to save changes",
          required: true,data: { password_visibility_target: "input", form_validation_target: "field", form_validation_required_message: "Current password is required to save changes." },
          class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
        </div>
        <div>
          <%= f.label :password, "New password", class: "text-sm font-medium " %>
          <%= f.password_field :password,autocomplete: "new-password",placeholder: "Leave blank to keep your current password",
          minlength: @minimum_password_length || Devise.password_length.min,pattern: "(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+",
          title: "Must include uppercase, lowercase, number, and special character.",data: { password_visibility_target: "input", form_validation_target: "field", 
          form_validation_pattern_message: "Password must include uppercase, lowercase, number, and special character." },
          class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "text-sm font-medium " %>
          <%= f.password_field :password_confirmation,autocomplete: "new-password",placeholder: "Repeat the new password",data: { password_visibility_target: "input",
          form_validation_target: "field", form_validation_required_if_field_id: "user_password", form_validation_required_message: "Password confirmation is required when setting a new password.", 
          form_validation_match_field_id: "user_password", form_validation_match_message: "Password confirmation must match the new password." },
          class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
        </div>
        <label class="flex items-center gap-3 text-sm">
          <input type="checkbox"class="h-4 w-4 rounded border-slate-300 text-[#44652d] focus:ring-[#44652d]/20"data-action="password-visibility#toggle">
          <span data-password-visibility-target="toggleLabel">Show password</span>
        </label>
        <%= f.submit "Save changes", 
        class: "mt-2 inline-flex w-full h-[35px] items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary" %>
      <% end %>
      <%= button_to "Logout", destroy_user_session_path, method: :delete,
        form: { data: { turbo: false } },
        class: "w-full h-[35px] mt-4 rounded-md border bg-red-700 text-sm font-semibold text-white transition hover:bg-red-800 focus:outline-none" %>
    </div>
  </div>
</div>
</section>
