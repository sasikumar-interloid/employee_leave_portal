<% content_for :title, "Edit Account" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>

<section class="mx-auto w-full 2xl:w-[50%] xl:w-[50%] lg:w-[50%] md:w-[50%] sm:w-[70%] overflow-hidden rounded-md bg-white shadow-xl">
  <div class="flex items-center px-3 py-4 sm:px-4 lg:px-6 lg:py-6">
    <div class="mx-auto w-full">
      <h1 class="text-lg font-semibold tracking-tigh sm:text-lg text-center">Manage your account</h1>
      <p class="mt-4 text-sm leading-7 text-center">
        Update your email or password and keep your access details current.
      </p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-10 space-y-6", data: { controller: "password-visibility" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            placeholder: "Enter your email",
                            class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition focus:border-primary" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Confirmation pending for <span class="font-semibold"><%= resource.unconfirmed_email %></span>.
          </div>
        <% end %>

        <div>
          <%= f.label :current_password, "Current password", class: "text-sm font-medium " %>
          <%= f.password_field :current_password,
                               autocomplete: "current-password",
                               placeholder: "Enter your current password to save changes",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
  
        </div>

        <div>
          <%= f.label :password, "New password", class: "text-sm font-medium " %>
          <%= f.password_field :password,
                               autocomplete: "new-password",
                               placeholder: "Leave blank to keep your current password",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
   
          <% if @minimum_password_length %>
            <p class="mt-2 text-xs leading-6 text-primary"><%= @minimum_password_length %> characters minimum.</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "text-sm font-medium " %>
          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               placeholder: "Repeat the new password",
                               data: { password_visibility_target: "input" },
                               class: "mt-2 w-full h-[35px] rounded-md border border-slate-300 px-4 text-sm  outline-none transition  focus:border-primary" %>
        </div>

        <label class="flex items-center gap-3 text-sm">
          <input type="checkbox"
                 class="h-4 w-4 rounded border-slate-300 text-[#44652d] focus:ring-[#44652d]/20"
                 data-action="password-visibility#toggle">
          <span data-password-visibility-target="toggleLabel">Show password</span>
        </label>

        <%= f.submit "Save changes", class: "mt-2 inline-flex w-full h-[35px] items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary" %>
      <% end %>

      <div class="my-8 border-t border-slate-200"></div>

      <div class="space-y-4">
        <div class="space-y-1 flex justify-between">
          <h3 class="text-lg font-semibold ">Session</h3>
        </div>

        <%= button_to "Logout",
                      destroy_user_session_path,
                      method: :delete,
                      class: "inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 focus:outline-none" %>

        <%= button_to "Delete your account",
                      registration_path(resource_name),
                      method: :delete,
                      class: "inline-flex items-center justify-center rounded-md bg-red-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-rose-600/20",
                      data: { confirm: "Are you sure you want to deactivate your account?", turbo_confirm: "Are you sure you want to deactivate your account?" } %>

      </div>
      </div>
    </div>
  </div>
</section>
