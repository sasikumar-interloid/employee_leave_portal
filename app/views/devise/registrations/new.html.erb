<% content_for :title, "Sign Up" %>

<% card_content = capture do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "text-sm font-semibold text-slate-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/15", placeholder: "you@company.com" %>
    </div>

    <div>
      <%= f.label :password, class: "text-sm font-semibold text-slate-700" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/15", placeholder: "Create a password" %>
      <% if @minimum_password_length %>
        <p class="mt-2 text-xs leading-6 text-slate-500"><%= @minimum_password_length %> characters minimum.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "text-sm font-semibold text-slate-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-teal-600 focus:ring-4 focus:ring-teal-600/15", placeholder: "Repeat your password" %>
    </div>

    <div>
      <%= f.submit "Create account", class: "inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-900/15" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>

<%= render "devise/shared/auth_frame",
           eyebrow: "New account",
           title: "Create your portal access",
           description: "Set up your account to start requesting leave and checking approval status without the back-and-forth.",
           aside_title: "Leave administration with less friction.",
           aside_body: "Employees can request time off, managers can approve faster, and everyone sees the same balance and timeline.",
           card_content: card_content %>
