<% content_for :title, "Sign Up" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>
<section class="mx-auto 2xl:w-[40%] xl:w-[45%] lg:w-[50%] md:w-[50%] sm:w-full overflow-hidden rounded-[8px] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)] lg:grid">
  <div class="flex items-center px-4 py-4 sm:px-10 lg:px-8 lg:py-8">
    <div class="mx-auto w-full">
      <h1 class="text-lg font-semibold tracking-tight text-center">Create your account</h1>
      <p class="mt-4 leading-7 text-sm">Set up access to manage leave requests, balances, and approvals in one place.</p>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-5 space-y-6", 
      data: { controller: "password-visibility form-validation", action: "submit->form-validation#validateForm focusout->form-validation#validateField input->form-validation#validateField" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div>
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email,autofocus: true,autocomplete: "email",placeholder: "Enter your email",required: true,
          data: { form_validation_target: "field", form_validation_required_message: "Email address is required." },
          class: "mt-2 w-full h-[35px] rounded-sm border border-slate-200 px-4 text-xs outline-none transition focus:border-primary" %>
        </div>
        <div>
          <div class="flex items-center justify-between gap-4">
            <%= f.label :password, class: "text-sm font-medium" %>
          </div>
          <%= f.password_field :password,autocomplete: "new-password",placeholder: "Create a password",
            required: true,minlength: @minimum_password_length || Devise.password_length.min,pattern: "(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).+",
            title: "Must include uppercase, lowercase, number, and special character.",
            data: { password_visibility_target: "input", form_validation_target: "field", form_validation_required_message: "Password is required.", 
            form_validation_pattern_message: "Password must include uppercase, lowercase, number, and special character." },
            class: "mt-2 w-full h-[35px] rounded-md border border-slate-200 px-4 text-xs outline-none transition focus:border-primary" %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "text-sm font-medium text-slate-900" %>
          <%= f.password_field :password_confirmation,autocomplete: "new-password",placeholder: "Confirm your password",required: true,data: { password_visibility_target: "input", form_validation_target: "field", form_validation_required_message: "Password confirmation is required.", form_validation_match_field_id: "user_password", form_validation_match_message: "Password confirmation must match the password." },class: "mt-2 w-full h-[35px] rounded-md border border-slate-200 px-4 text-xs outline-none transition focus:border-primary" %>
        </div>
        <label class="flex items-center gap-3 text-sm">
          <input type="checkbox"class="h-4 w-4 rounded border-slate-300 text-[#44652d] focus:ring-[#44652d]/20"data-action="password-visibility#toggle">
          <span data-password-visibility-target="toggleLabel">Show password</span>
        </label>
        <%= f.submit "Sign up", class: "mt-2 inline-flex w-full items-center justify-center rounded-md bg-primary px-4 h-[35px] text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>
      <div class="mt-8 text-center text-sm">
        Already have an account?
        <%= link_to "Login", new_session_path(resource_name), class: "font-semibold text-primary hover:text-secondary" %>
      </div>
    </div>
  </div>
</section>
