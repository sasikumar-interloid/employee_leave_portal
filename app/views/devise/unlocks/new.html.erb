<% content_for :title, "Unlock Account" %>
<% content_for :full_width_auth, true %>
<% content_for :hide_footer, true %>

<section class="mx-auto sm:w-[60%] md:w-[50%] lg:w-[50%] xl:w-[40%] 2xl:w-[40%] overflow-hidden rounded-[8px] bg-white shadow-[0_28px_80px_rgba(15,23,42,0.08)] lg:grid">
  <div class="flex items-center px-4 py-4 sm:px-10 lg:px-8 lg:py-8">
    <div class="mx-auto w-full">
      <h1 class="text-center text-lg font-semibold tracking-tight text-slate-950">
        Unlock your access
      </h1>
      <p class="mt-4 text-sm leading-7">
        Request a new unlock email to regain access to the portal.
      </p>
      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "text-sm font-semibold text-slate-700" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block h-[35px] w-full rounded-sm border border-slate-200 bg-white px-4 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-primary", placeholder: "you@company.com" %>
        </div>

        <div>
          <%= f.submit "Resend unlock instructions", class: "inline-flex h-[35px] w-full items-center justify-center rounded-sm bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none" %>
        </div>
      <% end %>

      <div class="mt-8">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</section>
