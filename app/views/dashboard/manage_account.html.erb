<% content_for :title, "Manage Account" %>
<section class="mx-auto max-w-3xl space-y-6">
  <%# Page header %>
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em]">Settings</p>
    <h1 class="mt-2 text-xl font-bold ">Manage account</h1>
  </div>
  <%# Account form %>
  <div class="rounded-sm border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_for(current_user, as: :user, url: registration_path(:user), html: { method: :put, class: "space-y-6",
        data: { controller: "password-visibility form-validation", action: "submit->form-validation#validateForm focusout->form-validation#validateField input->form-validation#validateField" } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: current_user %>
      <%# Email %>
      <div>
        <%= f.label :email, "Email address", class: "text-sm font-medium" %>
        <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "Enter your email",
          required: true,
          data: {
            form_validation_target: "field",
            form_validation_required_message: "Email address is required.",
          },
          class: "mt-2 h-[42px] w-full rounded-sm border border-slate-300 px-4 text-sm outline-none transition focus:border-primary" %>
      </div>
      <%# Actions %>
      <div class="flex justify-between pt-6">
        <%= f.submit "Save changes",
          class: "inline-flex h-[42px] items-center justify-center rounded-sm bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary" %>
      </div>
    <% end %>
    <%= form_with url: destroy_user_session_path, method: :delete, local: true, data: { turbo: false }, class: "pt-6" do %>
      <%= submit_tag "Logout",
        class: "inline-flex h-[42px] items-center justify-center rounded-sm border border-red-200 bg-red-700 px-5 text-sm font-semibold text-white transition hover:bg-red-800" %>
    <% end %>
  </div>
</section>
